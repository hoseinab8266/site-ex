# این فایل نمونه است؛ آن را به .env.local کپی کنید و مقادیر واقعی را جایگزین کنید.

# کلید امضای کوکی نشست (اجباری در محیط production)
SESSION_SECRET=یک-رشته-تصادفی-طولانی

# کلید رمز یک‌بارمصرف (اگر خالی بماند از SESSION_SECRET استفاده می‌شود)
OTP_SECRET=

# حساب مدیر اولیه (فقط هنگام اولین راه‌اندازی خوانده می‌شود)
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=مدیر سایت
ADMIN_PASSWORD=Polyrez@1405

# سرویس پیام‌رسان بله (Safir) برای ارسال رمز یک‌بارمصرف
BALE_SAFIR_ACCESS_KEY=
BALE_BOT_ID=

# ---------- امنیت پنل مدیریت ----------
# مسیر پنهان ورود کارکنان؛ اگر مقدار بگذارید، نشانی /admin/login با ۴۰۴ پنهان می‌شود
# و ورود کارکنان فقط از این مسیر ممکن است. مثال: panel-x7k9
ADMIN_LOGIN_PATH=

# فهرست سفید IP برای همهٔ مسیرهای مدیریتی و ورود کارکنان (با کاما جدا کنید).
# خالی بماند یعنی محدودیتی اعمال نمی‌شود. پشتیبانی از پیشوند با *
# مثال: 5.238.20.11,82.99.*
ADMIN_ALLOWED_IPS=

# ورود دومرحله‌ای (Google Authenticator) برای مدیر اجباری است؛ به‌صورت پیش‌فرض فعال است.
ADMIN_TOTP_REQUIRED=true
